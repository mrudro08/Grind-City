# ── Site ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://grindcitydetail.com

# ── Sanity (leave PROJECT_ID empty to run fully static) ────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=2g5iq8c7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Viewer token — only if the dataset is private
SANITY_API_READ_TOKEN=
# Editor token with create permission — lets /api/lead save leads into Sanity
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity → /api/revalidate webhook (min 16 chars)
SANITY_REVALIDATE_SECRET=

# ── Lead notifications (all optional; use any combination) ─────────────────────
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@grindcitydetail.com
LEAD_FROM_EMAIL=leads@grindcitydetail.com
